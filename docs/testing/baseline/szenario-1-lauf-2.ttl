# --- 1 Die Frage nach Gott (S. 12) ---
data:kb1-frage-nach-gott
    rdf:type      lp:LP_0030070 ;
    rdfs:label    "Die Frage nach Gott" ;
    lp:LP_0030056 [ a lp:LP_0000346 ; rdfs:label "1 Die Frage nach Gott" ] ;
    lp:LP_0030051 [ a lp:LP_0000852 ; rdfs:label "Die Frage nach Gott wird als existentielle Frage aufgeworfen. Sie konkretisiert sich für die Schülerinnen und Schüler im Kontext religiöser und kultureller Vielfalt." ] ;
    lp:LP_0000047 lp:LP_0000045 ;
    obo:BFO_0000051 data:kb1-pk-56 , data:kb1-themen-56 .

# Prozessbezogene Kompetenz (Jahrgangsstufen 5-6)
data:kb1-pk-56
    rdf:type      lp:LP_0030278 ;
    rdfs:label    "Die Schülerinnen und Schüler nehmen unterschiedliche Gottesvorstellungen wahr und beschreiben sie." ;
    lp:LP_0030056 [ a lp:LP_0000346 ; rdfs:label "Prozessbezogene Kompetenz (Jahrgangsstufen 5-6)" ] ;
    lp:LP_0000026 lp:LP_2000005 , lp:LP_2000006 .

# Moegliche Themen und Inhalte (Jahrgangsstufen 5-6)
data:kb1-themen-56
    rdf:type      lp:LP_0030280 ;
    rdfs:label    "Mögliche Themen und Inhalte (Jahrgangsstufen 5-6)" ;
    lp:LP_0030056 [ a lp:LP_0000346 ; rdfs:label "Mögliche Themen und Inhalte (Jahrgangsstufen 5-6)" ] ;
    lp:LP_0000026 lp:LP_2000005 , lp:LP_2000006 ;
    obo:BFO_0000051 data:kb1-themen-56-1 , data:kb1-themen-56-2 , data:kb1-themen-56-3 .

data:kb1-themen-56-1 rdf:type lp:LP_0030280 ; rdfs:label "Gottesvorstellungen (anthropomorph, symbolisch, allmächtig, gütig)" .
data:kb1-themen-56-2 rdf:type lp:LP_0030280 ; rdfs:label "Gottesvorstellungen in anderen Religionen" .
data:kb1-themen-56-3 rdf:type lp:LP_0030280 ; rdfs:label "Metaphorisches Sprechen von Gott (personal; apersonal)" .
