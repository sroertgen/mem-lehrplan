data:fachanforderung-ev-religion-sh-gym
    rdf:type          lp:LP_0000824 ;
    rdfs:label        "Fachanforderungen Evangelische Religion (Schleswig-Holstein, Gymnasium)" ;
    lp:LP_0030056     [ a lp:LP_0000346 ; rdfs:label "Fachanforderungen Evangelische Religion" ] ;
