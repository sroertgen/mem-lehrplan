# Auszug: 1 Die Frage nach Gott (S. 12), Sekundarstufe I / Gymnasium,
# Jahrgangsstufen 5-6
# ============================================================================

data:fachanforderung-ev-religion-sh
    rdf:type        lp:LP_0000824 ;
    rdfs:label      "Fachanforderungen Evangelische Religion (Schleswig-Holstein)" ;
    lp:LP_0030056   [ a lp:LP_0000346 ; rdfs:label "Fachanforderungen Evangelische Religion" ] ;
