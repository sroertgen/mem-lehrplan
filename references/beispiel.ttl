# Beispiel: ein minimaler MEM-Lehrplan nach den Mustern der Lehrplan-Ontologie
# (Pattern 1, 2, 5, 6). Land Schleswig-Holstein, erfundener Inhalt. Geprueft mit
# `mem-explorer check`: Exit 0 - siehe beispiel-bericht.md.
#
# Konventionen (references/konventionen.md): eigener Namensraum, lesbare stabile
# Slugs, ein Knoten je Punkt der Vorlage, Kommentar mit PDF-Seite am Knoten,
# Text woertlich, Literale ohne Sprachtag.
#
# Klassenpfad aus der realen SH-Fassung 6.0 (sekundarstufe.ttl) abgelesen:
# LP_0000824 „Fachanforderung (SH)“ -> LP_0030033 „Lehrplanfragment (SH)“ ->
# LP_0030070 „Kompetenzbereich (SH)“ -> LP_0030278 „Prozessbezogene Kompetenz (SH)“
# und LP_0030280 „Mögliches Thema und Inhalt (SH)“ (haeufigste Klasse in der Datei,
# 177 Vorkommen). obo:BFO_0000051 „hat Teil“ ist in lp-base.ttl als
# owl:ObjectProperty definiert (Zeile 110) - kein lp:/sf:/sa:-Term, daher kein
# Treffer bei lookup.sh, aber kein erfundenes ID.
#
# hat Position (LP_0000460) hat rdfs:range xsd:int -> "1"^^xsd:int, nicht
# xsd:integer. uri (LP_0000463) hat keinen deklarierten Range -> Literal bleibt
# ein einfacher String ohne Datentyp-Annotation.
#
# „Ziel ohne geforderte Klasse — hat Teil“ auf der Wurzel: LP_0000824 verlangt
# fuer obo:BFO_0000051 (owl:allValuesFrom) die Klasse LP_0002103 „Element (SH)“.
# LP_0030033 „Lehrplanfragment (SH)“ erreicht sie nur ueber eine anonyme
# OWL-Intersection (owl:equivalentClass), keinen benannten rdfs:subClassOf-Pfad
# - fuer SHACL ohne Reasoner unsichtbar (references/laender/SH.md, Abschnitt
# „Oberklasse ist ein anonymer OWL-Ausdruck“). Einzige Klasse mit benanntem
# Pfad zu LP_0002103 ist LP_0030274 „Verweis auf Basiskonzept (SH)“ (NaWi) -
# fachlich falsch fuer ein Lehrplanfragment. Deshalb: data:teil-sek1 traegt
# zusaetzlich zu lp:LP_0030033 explizit den Typ lp:LP_0002103 - das macht die
# vom Ontologie-Autor gemeinte Klassenzugehoerigkeit sichtbar, ohne einen
# Reasoner zu brauchen. Die dadurch neu faellige Anforderung „von Bundesland =
# Schleswig-Holstein“ (aus der equivalentClass-Definition von LP_0002103)
# erscheint im Bericht als sh:hasValue-Befund, automatisch als
# Reasoner-Artefakt eingeordnet (siehe mem-explorer CLAUDE.md, classify()).
#
# „Nicht verbunden“ (Regel R4): Identifikationsnummer-Knoten (LP_0000347) sind
# nicht in VALUE_PREDICATES (src/lib/iris.ts) - anders als Titel, Beschreibung
# und Jahrgangsstufe muessen sie zusaetzlich zu „hat Nummer“ auch ueber
# obo:BFO_0000051 erreichbar sein. Beide Nummer-Knoten stehen deshalb sowohl
# im „hat Nummer“- als auch im „hat Teil“-Ziel ihres Elternknotens.

@prefix lp:   <https://w3id.org/lehrplan/ontology/> .
@prefix obo:  <http://purl.obolibrary.org/obo/> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix data: <https://example.org/lehrplan/sh/beispiel/> .

# ---- Wurzel (Pattern 1) ------------------------------------------- S. 1
data:fachanforderung
    a lp:LP_0000824 ;                               # Fachanforderung (SH)
    rdfs:label "Beispiel-Fachanforderung Ev. Religion Sek I (SH)" ;
    lp:LP_0030056 data:fachanforderung-titel ;      # hat Titel
    lp:LP_0000029 lp:LP_3000054 ;                   # von Bundesland -> Schleswig-Holstein
    lp:LP_0000537 <https://w3id.org/schulfach/SH_0000008> ;  # hat Schulfach -> Evangelische Religion
    lp:LP_0000812 <https://w3id.org/schulart/SH_0000003> ;   # fuer Schulart -> Gymnasium
    lp:LP_0000047 lp:LP_0000045 ;                   # hat Schulstufe -> Sekundarbereich I
    lp:LP_0000463 "https://example.org/fachanforderungen-beispiel.pdf" ;  # uri (Originaldokument)
    obo:BFO_0000051 data:teil-sek1 .                # hat Teil

data:fachanforderung-titel
    a lp:LP_0000346 ;                               # Titel
    rdfs:label "Titel der Fachanforderung" ;
    lp:LP_0000344 "Fachanforderungen Evangelische Religion" .   # hat Wert

# ---- Fragment (Pattern 6) ----------------------------------------- S. 5
data:teil-sek1
    a lp:LP_0030033 , lp:LP_0002103 ;               # Lehrplanfragment (SH); Element (SH), s. Kommentar oben
    rdfs:label "Teil Sekundarstufe I" ;
    lp:LP_0030056 data:teil-sek1-titel ;
    lp:LP_0030057 data:teil-sek1-nummer ;           # hat Nummer
    lp:LP_0000460 "2"^^xsd:int ;                    # hat Position (Reihenfolge in der Vorlage)
    obo:BFO_0000051 data:teil-sek1-nummer , data:kb-gott .  # hat Teil: Nummer zusaetzlich hier, s. Kommentar oben

data:teil-sek1-titel  a lp:LP_0000346 ; rdfs:label "Titel Teil Sek. I" ; lp:LP_0000344 "II Fachanforderungen Sekundarstufe I" .
data:teil-sek1-nummer a lp:LP_0000347 ; rdfs:label "Nummer Teil Sek. I" ; lp:LP_0000344 "II" .   # Identifikationsnummer

# ---- Kompetenzbereich (CE-Bereich) -------------------------------- S. 12
data:kb-gott
    a lp:LP_0030070 ;                               # Kompetenzbereich (SH)
    rdfs:label "Die Frage nach Gott" ;
    lp:LP_0030056 data:kb-gott-titel ;
    lp:LP_0030051 data:kb-gott-beschreibung ;       # hat Beschreibung
    lp:LP_0030057 data:kb-gott-nummer ;
    lp:LP_0000460 "1"^^xsd:int ;
    obo:BFO_0000051 data:kb-gott-nummer , data:kb-gott-pk-1 , data:kb-gott-inhalt-1 , data:kb-gott-inhalt-2 .  # Nummer zusaetzlich hier, s. Kommentar oben

data:kb-gott-titel        a lp:LP_0000346 ; rdfs:label "Titel Kompetenzbereich Gott" ; lp:LP_0000344 "1 Die Frage nach Gott" .
data:kb-gott-nummer       a lp:LP_0000347 ; rdfs:label "Nummer Kompetenzbereich Gott" ; lp:LP_0000344 "1" .
data:kb-gott-beschreibung a lp:LP_0030003 ;         # Beschreibung
    rdfs:label "Beschreibung Kompetenzbereich Gott" ;
    lp:LP_0000344 "Die Frage nach Gott wird als existentielle Frage aufgeworfen und im Kontext religiöser Vielfalt konkretisiert." .

# ---- Prozessbezogene Kompetenz ------------------------------------ S. 12
data:kb-gott-pk-1
    a lp:LP_0030278 ;                               # Prozessbezogene Kompetenz (SH)
    rdfs:label "Gottesvorstellungen wahrnehmen" ;
    lp:LP_0030056 data:kb-gott-pk-1-titel ;
    lp:LP_0000026 lp:LP_2000005 , lp:LP_2000006 ;   # hat Jahrgangsstufe -> 5, 6
    lp:LP_0000460 "1"^^xsd:int .

data:kb-gott-pk-1-titel a lp:LP_0000346 ;
    rdfs:label "Titel Prozessbezogene Kompetenz 1" ;
    lp:LP_0000344 "Die Schülerinnen und Schüler nehmen unterschiedliche Gottesvorstellungen wahr und beschreiben sie." .

# ---- Moegliche Themen und Inhalte --------------------------------- S. 13
data:kb-gott-inhalt-1
    a lp:LP_0030280 ;                               # Moegliches Thema und Inhalt (SH)
    rdfs:label "Gottesvorstellungen" ;
    lp:LP_0030056 data:kb-gott-inhalt-1-titel ;
    lp:LP_0000026 lp:LP_2000005 , lp:LP_2000006 ;
    lp:LP_0000460 "2"^^xsd:int .
data:kb-gott-inhalt-1-titel a lp:LP_0000346 ;
    rdfs:label "Titel Inhalt 1" ;
    lp:LP_0000344 "Gottesvorstellungen (anthropomorph, symbolisch, allmächtig, gütig)" .

data:kb-gott-inhalt-2
    a lp:LP_0030280 ;
    rdfs:label "Metaphorisches Sprechen von Gott" ;
    lp:LP_0030056 data:kb-gott-inhalt-2-titel ;
    lp:LP_0000026 lp:LP_2000005 , lp:LP_2000006 ;
    lp:LP_0000460 "3"^^xsd:int .
data:kb-gott-inhalt-2-titel a lp:LP_0000346 ;
    rdfs:label "Titel Inhalt 2" ;
    lp:LP_0000344 "Metaphorisches Sprechen von Gott (personal; apersonal)" .
